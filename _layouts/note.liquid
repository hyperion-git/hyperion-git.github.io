---
layout: default
---
{% comment %}
  Site-local layout for the `notes` collection: page-style header with the date as the
  description line, serif running prose (ClockWerQ long-form pairing), MathJax site-wide.
{% endcomment %}
<div class="post note">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">
      {{ page.date | date: '%B %-d, %Y' }}
      {% if page.tags and page.tags.size > 0 %}
        &nbsp;&middot;&nbsp;
        {% for tag in page.tags -%}
          {{- tag -}}
          {%- unless forloop.last %}, {% endunless -%}
        {%- endfor %}
      {% endif %}
    </p>
  </header>

  <article class="note-body serif-prose">
    {{ content }}
  </article>
</div>
